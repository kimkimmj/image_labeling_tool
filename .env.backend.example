# Backend local runtime example
# FastAPI/Celery runs on local machine, infra runs in Docker.

APP_ENV=local
APP_PORT=8000

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ilt
DB_USER=ilt
DB_PASSWORD=ilt
DATABASE_URL=postgresql+psycopg://ilt:ilt@127.0.0.1:5432/ilt

# Redis (Celery broker/backend)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# MinIO (S3-compatible)
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=ilt-media
MINIO_SECURE=false
