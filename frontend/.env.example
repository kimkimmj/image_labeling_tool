# 프론트 API 베이스 (Vite — 반드시 VITE_ 접두사)
# 사용: cp .env.example .env
#
# 비우면 `/api/...` 상대 경로
#   - 로컬: vite.config.ts 의 `/api` → 8000 프록시
#   - prod: nginx 가 같은 호스트에서 `/api` 를 백엔드로 넘김
#


# 같은 compose 안이라서 컨테이너 이름(api) 써도 되나?
# VITE_API_BASE_URL에는 쓰면 안 됩니다.

# 사용자 브라우저 안의 JavaScript. 사용자 PC에서는 Docker DNS에 api 같은 이름이 없음 → http://api:8000 은 브라우저에서 해석이 안 됨

VITE_API_BASE_URL=http://127.0.0.1:8000
# 프록시 사용 시에는 nginx 설정 및 경로 사용
# 크로스 오리진이면 백엔드 CORS·쿠키 설정 필요.
