# docker-compose.prod.yml 과 함께 프로젝트 루트에 `.env` 로 복사해 사용하세요.
# (`docker compose` 가 자동으로 읽어 변수 치환에 사용합니다)
#
#   cp .env.compose.sample .env

# --- PostgreSQL (postgres 서비스) ---
POSTGRES_USER=ilt
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ilt

# --- MinIO ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change_me
MINIO_BUCKET=ilt-media

# --- 웹 (nginx, 호스트에서 노출하는 포트) ---
WEB_PORT=8080
