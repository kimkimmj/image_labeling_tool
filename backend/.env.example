# backend/.env 템플릿 — 복사: cp backend/.env.example backend/.env
#
# [로컬 개발] docker-compose.dev.yml + 호스트에서 uvicorn / Celery (`docs/runb.md`)
# [docker-compose.prod.yml] 루트 `.env`(compose용 DB/MinIO 비밀번호)와 맞추고,
#   compose `environment` 가 DB·Redis·MinIO 호스트(postgres, redis, minio)를 덮어씁니다.
#   OAuth·CORS·PUBLIC_APP_URL·세션은 실제 브라우저 URL로 (예: http://172.16.100.57:8080).

# --- 앱 (로컬 기본) ---
APP_ENV=local
APP_NAME="Image Labeling Tool API"
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ilt
DB_USER=ilt
DB_PASSWORD=ilt
DATABASE_URL=postgresql+psycopg://ilt:ilt@127.0.0.1:5432/ilt

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
OAUTH_SUCCESS_REDIRECT_URL=http://localhost:5173/

PUBLIC_APP_URL=http://localhost:5173
INVITE_LINK_TTL_SECONDS=600
INVITE_JOIN_PATH=/join

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# 로그인 시작 페이지가 localhost면 localhost 콜백, 127.0.0.1이면 IP 콜백을 자동 선택합니다.
# Google Cloud Console > OAuth 2.0 클라이언트 ID > 승인된 리디렉션 URI에 아래를 "그대로" 추가하세요.
# (둘 중 하나만 있으면 다른 호스트로 접속 시 Error 400: redirect_uri_mismatch 가 납니다.)
#   http://127.0.0.1:5173/api/auth/oauth/google/callback
#   http://localhost:5173/api/auth/oauth/google/callback
# 같은 클라이언트가 "웹 애플리케이션" 유형인지, URI 끝 슬래시·http/https 가 코드와 일치하는지 확인하세요.
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/oauth/google/callback

OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_CLIENT_SECRET=
OAUTH_NAVER_REDIRECT_URI=http://localhost:5173/api/auth/oauth/naver/callback

OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_CLIENT_SECRET=
OAUTH_KAKAO_REDIRECT_URI=http://localhost:5173/api/auth/oauth/kakao/callback

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=ilt-media
MINIO_SECURE=false

# -----------------------------------------------------------------------------
# docker-compose.prod.yml 배포 시 — 위 로컬 값 대신 아래 예시를 참고해
# CORS / PUBLIC_APP_URL / OAuth redirect 를 실제 접속 주소로 바꾸세요.
# (DB·Redis·MinIO 호스트/비밀번호 일부는 compose environment 가 덮어씁니다.)
#
# APP_ENV=production
# APP_NAME=Image Labeling Tool API
# CORS_ORIGINS=["http://172.16.100.57:8080"]
# PUBLIC_APP_URL=http://172.16.100.57:8080
# OAUTH_SUCCESS_REDIRECT_URL=http://172.16.100.57:8080/
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_SAMESITE=lax
# SESSION_TTL_SECONDS=604800
# DB_HOST=postgres
# DB_PASSWORD=change_me
# DATABASE_URL=postgresql+psycopg://ilt:change_me@postgres:5432/ilt
# REDIS_URL=redis://redis:6379/0
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/1
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minio
# MINIO_SECRET_KEY=change_me
# MINIO_BUCKET=ilt-media
# MINIO_SECURE=false
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=http://172.16.100.57:8080/api/auth/oauth/google/callback
# OAUTH_NAVER_CLIENT_ID=
# OAUTH_NAVER_CLIENT_SECRET=
# OAUTH_NAVER_REDIRECT_URI=http://172.16.100.57:8080/api/auth/oauth/naver/callback
# OAUTH_KAKAO_CLIENT_ID=
# OAUTH_KAKAO_CLIENT_SECRET=
# OAUTH_KAKAO_REDIRECT_URI=http://172.16.100.57:8080/api/auth/oauth/kakao/callback
# INVITE_LINK_TTL_SECONDS=600
# INVITE_JOIN_PATH=/join
